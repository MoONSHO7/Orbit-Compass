package-as: Orbit_Compass

externals:
  Libs/LibStub:
    url: https://github.com/wowace-clone/LibStub
    commit: d0d26a9a58eade74964ea95114ca0ab593271b1b
  # LibOrbitUI release 1.10 provides API 1.14; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: e93edc489fa63184012abb3c0c46202694131753
    path: LibOrbitUI/LibOrbitUI-1.0
  # LibOrbitSearch release 1.2 provides revision 5; pin its verified release commit.
  Libs/LibOrbitSearch-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: bcdf20687b3555fac7078b1bf044104fb8db167e
    path: LibOrbitSearch/LibOrbitSearch-1.0

ignore:
  - .git
  - .github
  - .scripts
  - .vscode
  - .env
  - .env.*
  - .release
  - .packager
  - .staging
  - .release-notes.md
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .stylua.toml
  - .styluaignore
  - Assets/Source
  - README.md
  - "**/README.md"
  - "**/*.svg"
  - "**/__pycache__"
  - "**/*.pyc"

enable-nolib-creation: no
