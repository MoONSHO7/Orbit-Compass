package-as: Orbit_Compass

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  Libs/LibStub:
    url: https://github.com/wowace-clone/LibStub
    commit: d0d26a9a58eade74964ea95114ca0ab593271b1b
  # LibOrbitUI release 1.15 provides API 1.18; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 0bd8378c47203771139d701a989d1d3bb3d19d63
    path: LibOrbitUI/LibOrbitUI-1.0
  # LibOrbitSearch release 1.5 provides revision 8; pin its verified release commit.
  Libs/LibOrbitSearch-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 0bd8378c47203771139d701a989d1d3bb3d19d63
    path: LibOrbitSearch/LibOrbitSearch-1.0

ignore:
  - .git
  - .github
  - .scripts
  - .vscode
  - .env
  - .env.*
  - .release
  - .packager
  - .staging
  - .release-notes.md
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .stylua.toml
  - .styluaignore
  - Assets/Source
  - README.md
  - "**/README.md"
  - "**/*.svg"
  - "**/__pycache__"
  - "**/*.pyc"

enable-nolib-creation: no
