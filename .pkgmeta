package-as: Orbit_Compass

externals:
  Libs/LibStub:
    url: https://github.com/wowace-clone/LibStub
    commit: d0d26a9a58eade74964ea95114ca0ab593271b1b
  # LibOrbitUI release 1.3 provides API 1.8; pin its verified release commit.
  Libs/LibOrbitUI-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 6c5fca4c663272a8b9123bdfad087c66750e4c1a
    path: LibOrbitUI/LibOrbitUI-1.0
  # LibOrbitSearch release 1.0 provides revision 3 and provider contract 1.
  Libs/LibOrbitSearch-1.0:
    url: https://github.com/MoONSHO7/Orbit-Libs
    commit: 6c5fca4c663272a8b9123bdfad087c66750e4c1a
    path: LibOrbitSearch/LibOrbitSearch-1.0

ignore:
  - .git
  - .github
  - .scripts
  - .vscode
  - .env
  - .env.*
  - .release
  - .packager
  - .staging
  - .release-notes.md
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .stylua.toml
  - .styluaignore
  - Assets/Source
  - README.md
  - "**/README.md"
  - "**/*.svg"
  - "**/__pycache__"
  - "**/*.pyc"

enable-nolib-creation: no
